{
	"name": "@daneren2005/shared-memory-physics",
	"description": "2D physics components and systems built on the shared-memory ECS.",
	"author": "Scott Jackson",
	"version": "1.9.2",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/daneren2005/shared-memory-physics.git"
	},
	"homepage": "https://github.com/daneren2005/shared-memory-physics#readme",
	"bugs": {
		"url": "https://github.com/daneren2005/shared-memory-physics/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"start": "vite --config examples/vite.config.ts",
		"build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
		"build:examples": "vite build --config examples/vite.config.ts",
		"build:game": "npm run build && node scripts/build-game.mjs",
		"preview:examples": "vite preview --config examples/vite.config.ts",
		"type-check": "tsc --noEmit",
		"lint": "cross-env NODE_ENV=production oxlint .",
		"lint:fix": "cross-env NODE_ENV=production oxlint --fix .",
		"test": "vitest run",
		"benchmark": "vitest bench --run",
		"release": "semantic-release",
		"prepare": "husky"
	},
	"devDependencies": {
		"@daneren2005/shared-memory-ecs": "^1.10.4",
		"@daneren2005/shared-memory-objects": "^1.6.2",
		"@semantic-release/git": "^11.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.6",
		"@vitest/web-worker": "^5.0.5",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"phaser": "^4.2.1",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"@daneren2005/shared-memory-ecs": "^1.10.0",
		"@daneren2005/shared-memory-objects": "^1.1.0"
	},
	"dependencies": {
		"flatbush": "^4.7.0"
	}
}
